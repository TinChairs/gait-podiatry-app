{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gait-podiatry-app",
  "version": "0.2.3",
  "identifier": "com.christiankerr.gait-podiatry-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gait-podiatry-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4RkNENDBENkExMjA3QkQKUldTOUJ4SnFEZFQ4NktNTGExUllUbXNoMFhPRXZ1K2EvMkZEeEUxSUlHZTQvUXpDVXVRZVdIRDEK",
      "endpoints": [
        "https://github.com/TinChairs/gait-podiatry-app/releases/latest/download/latest.json"
      ]
    }
  }
}