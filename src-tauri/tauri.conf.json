{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlusOne",
  "version": "0.2.6",
  "identifier": "com.christiankerr.gait-podiatry-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "+One Gait Lab",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
