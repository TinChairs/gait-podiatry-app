      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5NENBQTYyODg5MEZDMEIKUldRTC9KQ0lZcXBNMlYvYUhsaVV5NnJEYWNGV3Ewb0tTbjhlYUlma2hscG9TUXAya1ZkSTJqV0EK",
      "endpoints": [
        "https://github.com/TinChairs/gait-podiatry-app/releases/latest/download/latest.json"
      ]
